# MedSupAPP — environment template (no secrets; copy to .env.local)

# App URL (must match OAuth redirect URLs and Meta webhook host)
# Production canonical: https://www.medsupapp.com.br
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
SUPABASE_ACCESS_TOKEN=your-supabase-cli-token

# Email (Resend) — https://resend.com — domínio verificado (ex.: medsupapp.com.br)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=MedSupAPP <naoresponda@medsupapp.com.br>

# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# NextAuth / Auth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
AUTH_SECRET=change-me

# WhatsApp Business (Meta Cloud API) — see docs/WHATSAPP_BUSINESS_SETUP.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
CRON_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_FORMULARIO_LINK=
WHATSAPP_TEMPLATE_LEMBRETE_CONSULTA=
WHATSAPP_TEMPLATE_FORMULARIO_RECEBIDO=
WHATSAPP_TEMPLATE_CONFIRMACAO_PAGAMENTO=

# Internal ops (server-only; never NEXT_PUBLIC_)
ADMIN_EMAILS=admin@example.com
# Opcional: curl detalhado em prod — header x-health-config-secret
# HEALTH_CONFIG_SECRET=openssl-rand-hex-32
INTERNAL_PRODUCT_ID=medsupapp

# Asaas — ver docs/ASAAS_BILLING.md (sandbox ou produção)
# ASAAS_API_KEY=
# ASAAS_API_URL=https://sandbox.asaas.com/api/v3
# ASAAS_WEBHOOK_TOKEN=   # token do painel Webhooks (não é ASAAS_API_KEY)
# ASAAS_BILLING_ENFORCED=false   # local: false; Vercel Production: true
